{
  "name": "champions-hero",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-data.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "prebuild": "node scripts/prepare-data.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "pretest": "node scripts/prepare-data.mjs",
    "test": "vitest run",
    "test:research": "node --test research/catalog/catalog.test.cjs research/corpus/corpus.test.cjs"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@smogon/calc": "0.12.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "acorn": "8.19.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
